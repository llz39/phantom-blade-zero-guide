# ============================================================
# 《影之刃零》攻略客服 Demo · 环境变量模板
#
# 用法：copy .env.example .env，然后把 your_xxx 换成真实值。
# 本文件只放占位符，**不含任何真实密钥**；真实值只在 .env 里（已被 .gitignore 忽略）。
#
# 变量读取顺序（高 → 低）：
#   真实环境变量  >  game_guide_demo/.env  >  仓库根目录/.env  >  默认值
#   由 game_guide_demo/env_bootstrap.py 统一处理。
# ============================================================

# ------------------------------------------------------------
# LLM：命令生成 + 最终回答（同一个模型，不做多模型投票）
# 获取地址：阿里云百炼控制台 → API-KEY 管理
# ------------------------------------------------------------
QWEN_API_KEY=your_qwen_api_key
LLM_MODEL=qwen3.8-flash
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# ------------------------------------------------------------
# Embedding：建库与查询共用，必须与 Milvus collection 维度一致
# 注意：填 API 模型名，不要填本地 BGE 路径（容器里不加载本地模型）
# ------------------------------------------------------------
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_DIM=1024

# ------------------------------------------------------------
# Milvus：两种命名都支持，配一套即可
#   A. 项目内口径：MILVUS_URI + MILVUS_TOKEN
#   B. Zilliz 控制台口径：ZILLIZ_CLOUD_URI + ZILLIZ_CLOUD_TOKEN
#      （env_bootstrap 会自动映射到 MILVUS_*，无需重复填）
#
# 本地 Docker：http://127.0.0.1:19530，token 留空
# Zilliz Cloud：https://in03-xxxxxxxx.serverless.<region>.cloud.zilliz.com
# ------------------------------------------------------------
MILVUS_URI=your_zilliz_cloud_endpoint
MILVUS_TOKEN=your_zilliz_cloud_token
# ZILLIZ_CLOUD_URI=your_zilliz_cloud_endpoint
# ZILLIZ_CLOUD_TOKEN=your_zilliz_cloud_token
MILVUS_COLLECTION=game_guide_chunks

# ------------------------------------------------------------
# MySQL：会话、攻略登记、反馈、成本记录
# 建库脚本：scripts/init_mysql.sql
# ------------------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB=game_guide

# 会话存储：mysql（默认）或 json（仅本机无数据库时临时用）
TRACKER_STORE_TYPE=mysql
TRACKER_STORE_PATH=trackers

# ------------------------------------------------------------
# 服务与安全
# ------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
# CORS 白名单，逗号分隔；公网部署写正式域名
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# 调试接口（/inspect、/docs、/api/domain、/api/flows）默认关闭
ENABLE_DEBUG_ROUTES=false

# 限流：10 次/分钟/IP、100 次/天/IP
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_DAY=100
# 开发期每日总请求上限（成本护栏）
DAILY_REQUEST_LIMIT=300
# 单条输入长度上限（字符）
MAX_INPUT_CHARS=300

# 部署在反代后面（Render / Nginx / 云负载均衡）时必须设 true，
# 否则限流拿到的是反代 IP，全站共用一个桶；本地直连保持 false 防伪造。
TRUST_PROXY_HEADERS=false

# 成本估算单价（元/千 token），用于 cost_log 记账；按实际供应商账单校准
LLM_PRICE_IN_PER_K=0.0008
LLM_PRICE_OUT_PER_K=0.002

# ------------------------------------------------------------
# 本机代理例外（必须）
# 开着 Clash/系统代理时，127.0.0.1 的请求会被代理劫持成 404。
# ------------------------------------------------------------
NO_PROXY=localhost,127.0.0.1,::1
no_proxy=localhost,127.0.0.1,::1
